{
  "name": "chronicle",
  "version": "1.0.0",
  "description": "Electron + React + SQLite starter",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npx @electron/rebuild -f -w better-sqlite3 && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "test": "npm rebuild better-sqlite3 && vitest run",
    "test:watch": "npm rebuild better-sqlite3 && vitest",
    "build:renderer": "vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.3.1",
    "better-sqlite3": "^9.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.1.6",
    "vitest": "^4.1.6",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.example.chronicle",
    "productName": "chronicle",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "target": "nsis",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/linux/**"
      ]
    },
    "mac": {
      "target": "dmg",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/linux/**"
      ]
    },
    "linux": {
      "target": "AppImage",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v3/win32/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "release"
    }
  }
}
